{
  "cloak": {
    "python": ".venv/bin/python3",
    "maxHtmlBytes": 2000000,
    "timeoutMs": 45000
  },
  "browser": {
    "defaultSession": "mcp-main",
    "maxTabs": 15,
    "autoCloseRead": true
  },
  "camofox": {
    "maxBytes": 100000,
    "user": "mcp"
  },
  "ui": {
    "toolExamples": {
      "finance_quote": { "symbol": "NVDA" },
      "finance_crypto": { "pair": "BTCUSDT" },
      "social_sentiment": { "query": "NVDA OR NVIDIA", "limit": 3 },
      "browser_browse": { "url": "https://news.ycombinator.com" },
      "browser_act": { "action": "open", "args": { "url": "https://news.ycombinator.com" } },
      "web_search": { "query": "MCP server", "limit": 3 },
      "scrape_stealth": { "url": "https://expresso.pt" },
      "health": {},
      "auth_check": { "site": "github" },
      "auth_audit": {}
    }
  }
}
